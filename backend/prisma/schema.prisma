generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  role       String
  phone      String?
  createdAt  DateTime  @default(now())
  customer   Customer?
  carrier    Carrier?
  admin      Admin?
  mobileSessions MobileSession[]
}

model Customer {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  name    String
  user    User    @relation(fields: [userId], references: [id])
  orders  Order[]
  offers  OrderOffer[]
}

model Carrier {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  status      String   @default("PENDING_APPROVAL")
  fullName    String?
  capacity    Int?
  vehicleType String?
  regionId    Int?
  brand       String?
  plateNumber String?
  description String?
  photos      String?
  documents   String?
  user        User     @relation(fields: [userId], references: [id])
  region      Region?  @relation(fields: [regionId], references: [id])
  carrierRegions CarrierRegion[]
  vehicles    Vehicle[]
  orders      Order[]  @relation("CarrierAcceptedOrders")
  offers      OrderOffer[]
}

model Vehicle {
  id          Int       @id @default(autoincrement())
  carrierId   Int
  type        String
  brand       String
  plateNumber String
  capacity    Int?
  description String?
  features    String?
  photos      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  carrier     Carrier   @relation(fields: [carrierId], references: [id])
  orders      Order[]
}

model Order {
  id                     Int        @id @default(autoincrement())
  customerId             Int
  regionId               Int
  categoryId             Int
  vehicleType            String
  status                 String     @default("NEW")
  selectedOfferId        Int?
  adultsCount            Int?
  childrenCount          Int?
  passengersCount        Int?
  cargoDescription       String?
  weight                 Float?
  volume                 Float?
  routeFrom              String
  routeFromLat           Float?
  routeFromLng           Float?
  routeTo                String
  routeToLat             Float?
  routeToLng             Float?
  date                   DateTime
  price                  Float
  suggestedPrice         Float?
  depositPercent         Float      @default(10)
  depositAmount          Float?
  depositPayerRole       String?
  depositStatus          String     @default("NOT_REQUIRED")
  depositReference       String?
  depositRequestedAt     DateTime?
  depositSubmittedAt     DateTime?
  depositVerifiedAt      DateTime?
  depositRejectedAt      DateTime?
  depositVerificationNote String?
  customerConfirmedAt    DateTime?
  contactsUnlockedAt     DateTime?
  customerNameSnapshot   String?
  customerContactSnapshot String?
  carrierNameSnapshot    String?
  carrierContactSnapshot String?
  driverNameSnapshot     String?
  driverPhoneSnapshot    String?
  vehicleBrandSnapshot   String?
  vehiclePlateSnapshot   String?
  estimatedDistanceKm    Float?
  estimatedDurationHours Float?
  pickupEtaText          String?
  comment                String?
  createdAt              DateTime   @default(now())
  returnSourceOrderId    Int?
  customer               Customer   @relation(fields: [customerId], references: [id])
  region                 Region     @relation(fields: [regionId], references: [id])
  category               Category   @relation(fields: [categoryId], references: [id])
  carrier                Carrier?   @relation("CarrierAcceptedOrders", fields: [carrierId], references: [id])
  carrierId              Int?
  vehicle                Vehicle?   @relation(fields: [vehicleId], references: [id])
  vehicleId              Int?
  returnSourceOrder      Order?     @relation("ReturnTripOrders", fields: [returnSourceOrderId], references: [id])
  returnOrders           Order[]    @relation("ReturnTripOrders")
  offers                 OrderOffer[]
  events                 OrderEvent[]
}

model OrderOffer {
  id            Int      @id @default(autoincrement())
  orderId       Int
  carrierId     Int
  customerId    Int
  proposedPrice Float
  pickupEtaText String?
  note          String?
  status        String   @default("ACTIVE")
  lastActor     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
  carrier       Carrier  @relation(fields: [carrierId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])

  @@unique([orderId, carrierId])
}

model OrderEvent {
  id         Int      @id @default(autoincrement())
  orderId     Int
  actorRole   String
  actorLabel  String?
  eventType   String
  message     String
  payload     String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Region {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  orders   Order[]
  carriers Carrier[]
  carrierRegions CarrierRegion[]
}

model CarrierRegion {
  id        Int      @id @default(autoincrement())
  carrierId Int
  regionId  Int
  carrier   Carrier  @relation(fields: [carrierId], references: [id])
  region    Region   @relation(fields: [regionId], references: [id])

  @@unique([carrierId, regionId])
}

model Category {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  orders  Order[]
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model PricingRule {
  id               Int      @id @default(autoincrement())
  vehicleType      String   @unique
  basePrice        Float    @default(0)
  pricePerKm       Float    @default(0)
  pricePerHour     Float    @default(0)
  minPrice         Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MobileAuthChallenge {
  id            String   @id @default(cuid())
  phone         String
  role          String
  name          String
  codeHash      String
  channel       String   @default("DEBUG")
  failedAttempts Int     @default(0)
  maxAttempts   Int      @default(5)
  requestedByIp String?
  userAgent     String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model MobileSession {
  id               String   @id @default(cuid())
  userId           Int
  role             String
  refreshTokenHash String
  deviceId         String?
  deviceName       String?
  platform         String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastSeenAt       DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
