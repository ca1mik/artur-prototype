{
  "name": "transport-aggregator-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/bot/start.ts",
    "dev:server": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-dist-imports.mjs",
    "start": "node dist/api/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dbpush": "prisma db push --skip-generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup:local": "npm run prisma:dbpush && npm run prisma:seed",
    "lint": "eslint . --ext .ts",
    "fix:unicode": "node ../fix-unicode.js",
    "campaign:preview": "tsx src/tools/sendSalesCampaign.ts --dry-run",
    "campaign:send": "tsx src/tools/sendSalesCampaign.ts",
    "sales:tracker": "tsx src/tools/buildNegotiationTracker.ts",
    "freelance:check": "tsx src/tools/runFreelanceBidAutomation.ts --check",
    "freelance:prepare": "tsx src/tools/runFreelanceBidAutomation.ts",
    "freelance:submit": "tsx src/tools/runFreelanceBidAutomation.ts --submit",
    "inbox:monitor": "tsx src/tools/monitorInbox.ts --write-doc --draft-replies",
    "inbox:watch": "tsx src/tools/runInboxMonitorLoop.ts --unseen --write-doc --draft-replies --use-ollama",
    "inbox:test-ollama": "tsx src/tools/monitorInbox.ts --write-doc --draft-replies --use-ollama --sample-file=../sales/samples/inbox-kp-request.txt",
    "qa:hard": "tsx src/tools/runHardQa.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.76.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.0.0",
    "https-proxy-agent": "^9.0.0",
    "imapflow": "^1.3.3",
    "ioredis": "^5.3.2",
    "mailparser": "^3.9.8",
    "nodemailer": "^6.10.1",
    "pino": "^8.16.0",
    "telegraf": "^4.16.1",
    "telegraf-session-local": "^2.1.1",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.15.0",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^7.12.3",
    "@typescript-eslint/parser": "^7.12.3",
    "eslint": "^8.57.0",
    "pino-pretty": "^10.1.0",
    "playwright": "^1.60.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2"
  }
}
