BOT_TOKEN=your_telegram_bot_token
APP_URL=https://your-domain.com
WEBHOOK_PATH=/webhook/telegram
PORT=3000
TELEGRAM_ENABLED=true
TELEGRAM_PROXY_URL=http://127.0.0.1:10808
ROUTING_PROXY_URL=http://127.0.0.1:10808
ROUTING_GEOCODER_URL=https://nominatim.openstreetmap.org/search
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
ROUTING_USER_AGENT=transport-aggregator-bot/1.0
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@db:5432/transport?schema=public
REDIS_URL=redis://redis:6379
USE_WEBHOOK=true
USE_REDIS_QUEUE=true
ADMIN_SECRET=supersecretpassword
MOBILE_AUTH_SECRET=supersecretmobiletoken
MOBILE_AUTH_DEBUG=false
PRISMA_LOG_QUERIES=false
ADMIN_TELEGRAM_ID=
CHILD_TRIP_LEAD_HOURS=72
CHILD_TRIP_NIGHT_START_HOUR=22
CHILD_TRIP_NIGHT_END_HOUR=6
